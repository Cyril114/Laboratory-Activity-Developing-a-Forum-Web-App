{{> header}}
{{#discussion}}
<h1>{{title}}</h1>
<p>{{body}}</p>
<p class="meta">by {{author}} · {{created_at}} UTC</p>
{{/discussion}}

<h2>Comments</h2>
{{#comments}}
  {{> comment}}
{{/comments}}
{{^comments}}<p>No comments yet.</p>{{/comments}}

<h3>Add a top-level comment</h3>
{{#loggedIn}}
<form method="post" action="/discussions/{{discussion.id}}/comments">
  <input type="hidden" name="csrf" value="{{csrf}}">
  <textarea name="body" rows="3" cols="60" required maxlength="2000"></textarea><br>
  <button>Post comment</button>
</form>
{{/loggedIn}}
{{^loggedIn}}<p><a href="/login">Log in</a> to post.</p>{{/loggedIn}}
{{> footer}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Nested Forum</title>
  <style>
    body { font-family: sans-serif; max-width: 800px; margin: 20px auto; }
    .comment { border-left: 3px solid #ccc; padding: 6px 10px; margin: 8px 0; }
    .meta { color: #666; font-size: 0.85em; }
    .meta img { width: 24px; height: 24px; vertical-align: middle; border-radius: 50%; }
    .error { color: #b00; }
    nav form { display: inline; }
  </style>
</head>
<body>
<nav>
  <a href="/discussions/1">Home</a> |
  {{#loggedIn}}
    Logged in as <strong>{{username}}</strong>
    <form method="post" action="/logout">
      <input type="hidden" name="csrf" value="{{csrf}}">
      <button>Log out</button>
    </form>
  {{/loggedIn}}
  {{^loggedIn}}
    <a href="/login">Log in</a> | <a href="/register">Register</a>
  {{/loggedIn}}
</nav>
<hr>